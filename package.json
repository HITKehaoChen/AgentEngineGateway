{
  "name": "agent-engine-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts --engine fake",
    "package:solution": "node scripts/phase4/package-solution.mjs",
    "phase4:score": "node scripts/phase4/score-matrix.mjs",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "opencode-ai": "1.18.26",
    "typebox": "1.3.7"
  }
}
